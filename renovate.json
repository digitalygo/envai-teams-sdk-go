{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Rome",
  "schedule": [
    "* 11-12 * * 3"
  ],
  "enabledManagers": [
    "gomod",
    "pip_requirements",
    "npm",
    "github-actions"
  ],
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "{{manager}} patch dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": [
        "gomod",
        "pip_requirements",
        "npm"
      ],
      "semanticCommitType": "build"
    }
  ]
}
